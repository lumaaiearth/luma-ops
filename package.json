{
  "name": "luma-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node scripts/test-leistungsnachweis.mjs && node scripts/test-sensor-series.mjs && node scripts/test-biome-format.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:test": "bash scripts/test-migration.sh",
    "abnahme": "playwright test",
    "abnahme:mobil": "playwright test --project=mobil",
    "gate": "bash scripts/merge-gate.sh",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "icons": "npm i --no-save sharp && node scripts/gen-icons.mjs && npx cap sync",
    "tiles": "node scripts/upload-tiles.mjs",
    "fortschritt": "node scripts/fortschritt.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/geo-layers": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@deck.gl/mesh-layers": "^9.3.7",
    "@geoman-io/leaflet-geoman-free": "^2.19.3",
    "@luma.gl/engine": "^9.3.6",
    "@supabase/supabase-js": "^2.106.2",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "suncalc": "^1.9.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
