  "methoden": [
    {
      "id": "M-BAUM-REGELKONTROLLE",
      "name": "Regelkontrolle, Sichtkontrolle vom Boden",
      "beschreibung": "Fachlich qualifizierte Inaugenscheinnahme vom Boden aus, jeder Baum einzeln und von allen Seiten, Bereiche Krone, Stamm und Wurzel.",
      "einheit": null,
      "erfassungsart": "person_vor_ort",
      "standard_id": "BAUM-DE-11"
    },
    {
      "id": "M-BAUM-UMFANG",
      "name": "Stammumfang mit Maßband in 1,30 m Höhe",
      "beschreibung": "Messung des Stammumfangs mit dem Umfangmaßband in 1,30 m Höhe über dem Erdboden. Liegt der Kronenansatz darunter, wird unmittelbar unter dem Kronenansatz gemessen und dies vermerkt.",
      "einheit": "cm",
      "erfassungsart": "person_vor_ort",
      "standard_id": "BAUM-BE-06"
    },
    {
      "id": "M-BAUM-VITALITAET",
      "name": "Vitalitätsbeurteilung nach Roloff",
      "beschreibung": "Beurteilung der Oberkrone anhand von Verzweigungsentwicklung und Kronenstruktur, Einstufung nach VS 0 bis VS 3 beziehungsweise S oder K.",
      "einheit": null,
      "erfassungsart": "person_vor_ort",
      "standard_id": "BAUM-DE-10"
    },
    {
      "id": "M-FE-SPLAT-REKONSTRUKTION",
      "name": "Rekonstruktion eines 3D-Gaussian-Splat-Felds aus Bilddaten",
      "beschreibung": "Aus den Bildern eines Flugs wird ein Feld aus Gaußfunktionen trainiert und nach KHR_gaussian_splatting als glTF-Binärdatei abgelegt. Das Ergebnis ist ein Modell, keine Messung: Lage, Form und Farbe jeder Gaußfunktion sind Trainingsergebnisse. Die Farbwerte sind anzeigebezogen (display-referred) und ausdrücklich keine Reflektanz.",
      "einheit": null,
      "erfassungsart": "modell",
      "standard_id": "FE-GS-23"
    },
    {
      "id": "M-FE-SPLAT-VERORTUNG",
      "name": "Verortung eines Splat-Felds über Passpunkte",
      "beschreibung": "Das Splat-Feld liegt in einem lagefreien lokalen System in Metern. Die Zuordnung zu einer Position im Gelände erfolgt über am Boden eingemessene Passpunkte: Ankerpunkt, Höhe und Drehung gegen Nord werden bestimmt und am Feld gespeichert. Die erreichte Lagegenauigkeit ist am Flug zu belegen, nicht hier.",
      "einheit": "m",
      "erfassungsart": "person_vor_ort",
      "standard_id": null
    },
    {
      "id": "M-IMPORT-ALTBESTAND",
      "name": "Übernahme aus dem BIOME-Altbestand",
      "beschreibung": "Maschinelle Übernahme aus map_features. Erfasst wurde die Identität des Baums (Nummer, Art, Lage). Die Fachangaben der Altdaten sind nicht übernommen, weil ihnen Methode, Messhöhe und Person fehlen.",
      "einheit": null,
      "erfassungsart": "fremddaten",
      "standard_id": "BIOME-ALT-01"
    },
    {
      "id": "M-TAXON-GBIF",
      "name": "Artbestimmung mit Abgleich gegen GBIF Backbone",
      "beschreibung": "Bestimmung im Feld, anschließend Abgleich des wissenschaftlichen Namens gegen die GBIF Backbone Taxonomy; usageKey, scientificName, confidence und matchType werden übernommen.",
      "einheit": null,
      "erfassungsart": "person_vor_ort",
      "standard_id": "BAUM-INT-14"
    }
  ],
  "standards": [
    {
      "id": "BAUM-BE-06",
      "kurzname": "Stammumfang — Messhöhe 1,30 m",
      "herausgeber": "Land Berlin, Baumschutzverordnung (BaumSchVO) vom 11. Januar 1982, Wiedergabe in FAOLEX",
      "quelle_url": "https://faolex.fao.org/docs/pdf/ger74205.pdf",
      "abgerufen_am": "2026-08-09",
      "zitat": "Geschützt sind: 1. alle Laubbäume, 2. die Nadelgehölzart Waldkiefer sowie 3. die Obstbaumarten Walnuss und Türkischer Baumhasel, jeweils mit einem Stammumfang ab 80 cm, gemessen in einer Höhe von 1,30 m über dem Erdboden. Liegt der Kronenansatz unter dieser Höhe, ist der Stammumfang unmittelbar unter dem Kronenansatz maßgebend."
    },
    {
      "id": "BAUM-DE-10",
      "kurzname": "Roloff-Vitalitätsstufen VS 0–3 plus S und K",
      "herausgeber": "Andreas Roloff, TU Dresden; veröffentlicht von der Deutschen Dendrologischen Gesellschaft",
      "quelle_url": "https://ddg-web.de/files/DDG-Championtrees/ChT-Downloads/Vitalitaetsbeurteilung%20von%20Champion%20Trees.pdf",
      "abgerufen_am": "2026-08-09",
      "zitat": "Folgende Vitalitätsstufen (VS) werden unterschieden (Beurteilung der Oberkrone). Damit wird das längerfristige Wuchspotenzial beurteilt, im Unterschied zur Bewertung der Kronentransparenz („Laubverlust\"), die kurzfristige Veränderungen der Blattfläche/Kronendichte erfasst."
    },
    {
      "id": "BAUM-DE-11",
      "kurzname": "Regelkontrolle als fachlich qualifizierte Inaugenscheinnahme",
      "herausgeber": "BADK und GALK-Arbeitskreis Stadtbäume, Musterdienstanweisung für Baumkontrollen 2021",
      "quelle_url": "https://galk.de/arbeitskreise/stadtbaeume/themenuebersicht/musterdienstanweisung-fuer-regelkontrollen-von-baeumen/",
      "abgerufen_am": "2026-08-09",
      "zitat": "Die Regelkontrolle erfolgt als Sichtkontrolle in Form der „fachlich qualifizierten Inaugenscheinnahme\" vom Boden aus. Dabei ist jeder Baum einzeln und von allen Seiten im Kronen-, Stamm- und Wurzelbereich visuell zu kontrollieren."
    },
    {
      "id": "BAUM-INT-14",
      "kurzname": "GBIF Backbone Taxonomy als Namensreferenz",
      "herausgeber": "GBIF Secretariat (Global Biodiversity Information Facility)",
      "quelle_url": "https://api.gbif.org/v1/species/match",
      "abgerufen_am": "2026-08-09",
      "zitat": "The GBIF Backbone Taxonomy is a single, synthetic management classification with the goal of covering all names GBIF is dealing with. Lizenz CC BY 4.0, DOI 10.15468/39omei, pubDate 2023-08-28."
    },
    {
      "id": "BIOME-ALT-01",
      "kurzname": "Übernahme des BIOME-Altbestands",
      "herausgeber": "LUMA (eigene Festlegung, keine externe Norm)",
      "quelle_url": "docs/BIOME_UMSTELLUNG.md",
      "abgerufen_am": "2026-08-15",
      "zitat": "Die Identität eines Altbaums wird in den Datenkern übernommen, seine Fachangaben nicht. Sie bleiben als Altangabe ohne Methode, Messhöhe und Person erhalten und werden als solche gekennzeichnet, weil sie die Anforderungen des Nachweiskerns nicht erfüllen und nicht nachträglich erfüllt werden können."
    },
    {
      "id": "FE-GS-23",
      "kurzname": "KHR_gaussian_splatting — 3D-Gaussian-Splats in glTF",
      "herausgeber": "The Khronos Group Inc., 3D Formats Working Group",
      "quelle_url": "https://raw.githubusercontent.com/KhronosGroup/glTF/main/extensions/2.0/Khronos/KHR_gaussian_splatting/README.md",
      "abgerufen_am": "2026-08-15",
      "zitat": "This extension defines basic support for storing 3D Gaussian splats in glTF assets, bringing structure and conformity to the 3D Gaussian splatting space. This extension defines 3D Gaussian splats by their position, rotation, scale, opacity, and spherical harmonics, which provide both diffuse and specular color. Status: Release Candidate."
    }
  ],
